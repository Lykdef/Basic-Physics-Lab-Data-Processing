{
  "name": "physical-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "playwright test",
    "test:desktop": "node tests/desktop.mjs",
    "setup:compute": "python -m pip install --target .python-deps -r compute/requirements.txt",
    "package:windows": "npm run build && node scripts/package-windows.mjs"
  },
  "dependencies": {
    "jstat": "^1.9.6",
    "lucide-vue-next": "^0.468.0",
    "vue": "^3.5.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "electron": "^41.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  }
}
